{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answers.schema.json",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "enum": [
              "first",
              "second",
              "equal"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "case_id",
    "answers"
  ],
  "additionalProperties": false
}
